// Balão de áudio estilo WhatsApp. Se o áudio (base64) ainda não tiver
// sido configurado, não mostra nada — assim dá pra deixar os pontos de
// chamada no código já prontos antes de ter os arquivos.
function mostrarAudio(base64Audio, duracaoLabel){
  if(!base64Audio) return;

  const barras = Array.from({length: 22}, () => 6 + Math.round(Math.random() * 14));

  const div = document.createElement('div');
  div.className = 'audio-msg';
  div.innerHTML = `
    <button class="audio-play" type="button" aria-label="Tocar áudio">
      <svg viewBox="0 0 24 24" fill="currentColor" class="icone-play"><path d="M8 5v14l11-7z"/></svg>
      <svg viewBox="0 0 24 24" fill="currentColor" class="icone-pause" style="display:none;"><path d="M6 5h4v14H6zM14 5h4v14h-4z"/></svg>
    </button>
    <div class="audio-wave">
      ${barras.map(h => `<span style="height:${h}px"></span>`).join('')}
    </div>
    <span class="audio-time">${duracaoLabel || ''}</span>
    <audio preload="none" src="${base64Audio}"></audio>
  `;
  thread.appendChild(div);
  scrollBottom();

  const audioEl = div.querySelector('audio');
  const btn = div.querySelector('.audio-play');
  const iconPlay = div.querySelector('.icone-play');
  const iconPause = div.querySelector('.icone-pause');
  const wave = div.querySelector('.audio-wave');
  const timeEl = div.querySelector('.audio-time');

  btn.addEventListener('click', () => {
    if(audioEl.paused){
      audioEl.play();
      iconPlay.style.display = 'none';
      iconPause.style.display = '';
      wave.classList.add('playing');
    } else {
      audioEl.pause();
    }
  });
  audioEl.addEventListener('pause', () => {
    iconPlay.style.display = '';
    iconPause.style.display = 'none';
    wave.classList.remove('playing');
  });
  audioEl.addEventListener('ended', () => {
    iconPlay.style.display = '';
    iconPause.style.display = 'none';
    wave.classList.remove('playing');
    timeEl.textContent = duracaoLabel || '';
  });
  audioEl.addEventListener('timeupdate', () => {
    if(!isNaN(audioEl.duration)){
      const restante = Math.max(0, audioEl.duration - audioEl.currentTime);
      const m = Math.floor(restante / 60);
      const s = Math.floor(restante % 60).toString().padStart(2, '0');
      timeEl.textContent = `${m}:${s}`;
    }
  });
}

