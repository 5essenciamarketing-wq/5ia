// Agrega os serviços escolhidos (relevante quando a cliente pede mãos + pés)
function servicoAgregado(){
  const nome = state.servicos.map(s=>s.nome).join(" + ");
  const duracao = state.servicos.reduce((a,s)=>a+(s.duracao||0), 0);
  const todosConfirmados = state.servicos.every(s=>s.confirmado);
  const preco = todosConfirmados ? state.servicos.reduce((a,s)=>a+(s.preco||0), 0) : null;
  const incluiEsmaltacao = state.servicos.some(s=>s.incluiEsmaltacao);
  return { nome, duracao, preco, confirmado: todosConfirmados, incluiEsmaltacao };
}

