<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<title>Carolina Beauty — Agendamento</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,500&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --cream:#FBF6F4;
    --panel:#FFFFFF;
    --ink:#3A2C2A;
    --ink-soft:#8A7472;
    --wine:#B4827D;
    --wine-deep:#8F5F5A;
    --gold:#C9A08C;
    --blush:#F5E5E2;
    --blush-line:#EAD4D0;
    --shadow: 0 18px 50px -20px rgba(58,44,42,0.25);
  }
  *{box-sizing:border-box;}
  html,body{height:100%; overflow-x:hidden;}
  html{ touch-action:manipulation; } /* evita zoom por duplo-toque, mantém scroll normal */
  body{
    margin:0;
    font-family:'Manrope',sans-serif;
    background:
      radial-gradient(circle at 15% 0%, #FBEFED 0%, transparent 55%),
      radial-gradient(circle at 100% 100%, #F6E4E1 0%, transparent 50%),
      var(--cream);
    color:var(--ink);
    display:flex;
    align-items:center;
    justify-content:center;
    padding:24px;
  }
  .app{
    width:100%;
    max-width:430px;
    height:min(760px, 92vh);
    background:var(--panel);
    border-radius:28px;
    box-shadow:var(--shadow);
    display:flex;
    flex-direction:column;
    overflow:hidden;
    border:1px solid var(--blush-line);
    position:relative; /* trava o painel "Agendamentos" dentro do próprio cartão do celular */
  }
  header.top{
    background:linear-gradient(135deg, var(--wine) 0%, var(--wine-deep) 100%);
    color:#fff;
    padding:20px 22px 18px;
    display:flex;
    align-items:center;
    gap:14px;
    position:relative;
  }
  header.top::after{
    content:"";
    position:absolute;
    left:0; right:0; bottom:-1px;
    height:10px;
    background:
      radial-gradient(circle, var(--wine-deep) 45%, transparent 46%) 0 0/16px 16px repeat-x;
    opacity:.9;
  }
  .head-text{display:flex;flex-direction:column;line-height:1.25;}
  .head-text .name{font-family:'Fraunces',serif;font-weight:600;font-size:1.15rem;letter-spacing:.2px;}
  .head-text .status{font-size:.75rem;color:#F5E1DD;display:flex;align-items:center;gap:6px;}
  .dot{width:6px;height:6px;border-radius:50%;background:#7CE0A6;display:inline-block;}

  main.thread{
    flex:1;
    overflow-y:auto;
    padding:20px 16px 10px;
    display:flex;
    flex-direction:column;
    gap:10px;
    background-color:var(--cream);
    background-image:
      linear-gradient(rgba(251,246,244,.88), rgba(251,246,244,.88)),
      url("data:image/png;base64,");
    background-repeat:no-repeat, repeat;
    background-size:100% 100%, 150px auto;
    background-position:0 0, 0 0;
  }
  main.thread::-webkit-scrollbar{width:6px;}
  main.thread::-webkit-scrollbar-thumb{background:var(--blush-line);border-radius:10px;}

  .msg{
    max-width:80%;
    padding:11px 14px;
    border-radius:16px;
    font-size:.92rem;
    line-height:1.45;
    animation:rise .25s ease both;
  }
  @keyframes rise{from{opacity:0; transform:translateY(6px);} to{opacity:1; transform:translateY(0);}}
  .msg.bot{
    align-self:flex-start;
    background:var(--blush);
    color:var(--ink);
    border-bottom-left-radius:4px;
  }
  .msg.user{
    align-self:flex-end;
    background:var(--wine);
    color:#fff;
    border-bottom-right-radius:4px;
    display:flex;
    align-items:flex-end;
    gap:5px;
  }
  .msg.user .msg-texto{ flex:1; }
  .msg.user .ticks{
    flex-shrink:0;
    display:inline-flex;
    color:rgba(255,255,255,.6);
    transition:color .3s ease;
    margin-bottom:1px;
  }
  .msg.user .ticks.lido{ color:#53BDEB; }
  .msg b{font-weight:700;}
  .msg .price{color:var(--wine-deep); font-weight:700;}
  .msg.bot .price{color:var(--wine);}

  .typing{
    align-self:flex-start;
    display:flex; gap:4px;
    background:var(--blush);
    padding:12px 16px;
    border-radius:16px;
    border-bottom-left-radius:4px;
  }
  .typing span{
    width:6px;height:6px;border-radius:50%;
    background:var(--wine);
    opacity:.5;
    animation:blink 1.1s infinite ease-in-out;
  }
  .typing span:nth-child(2){animation-delay:.15s;}
  .typing span:nth-child(3){animation-delay:.3s;}
  @keyframes blink{0%,80%,100%{opacity:.3; transform:translateY(0);} 40%{opacity:1; transform:translateY(-2px);}}

  .choices{
    align-self:flex-start;
    display:flex;
    flex-wrap:wrap;
    gap:8px;
    max-width:92%;
    margin-top:2px;
  }
  .chip{
    border:1.5px solid var(--wine);
    color:var(--wine);
    background:#fff;
    padding:9px 14px;
    border-radius:999px;
    font-size:.85rem;
    font-weight:600;
    cursor:pointer;
    transition:.15s;
    font-family:'Manrope',sans-serif;
  }
  .chip:hover{background:var(--wine); color:#fff;}
  .chip:disabled{opacity:.4; cursor:default;}
  .chip.ghost{border-color:var(--blush-line); color:var(--ink-soft);}
  .chip.ghost:hover{background:var(--blush); color:var(--ink);}

  .composer{
    display:flex;
    gap:10px;
    padding:14px 16px;
    border-top:1px solid var(--blush-line);
    background:#fff;
  }
  .composer input{
    flex:1;
    border:1.5px solid var(--blush-line);
    border-radius:999px;
    padding:11px 16px;
    font-size:16px; /* >=16px evita zoom automático do iOS ao focar o campo */
    font-family:'Manrope',sans-serif;
    outline:none;
    background:var(--cream);
    color:var(--ink);
  }
  .composer input:focus{border-color:var(--wine);}
  .composer button{
    width:44px;height:44px;
    border-radius:50%;
    border:none;
    background:var(--wine);
    color:#fff;
    cursor:pointer;
    display:flex;align-items:center;justify-content:center;
    flex-shrink:0;
    transition:.15s;
  }
  .composer button:hover{background:var(--wine-deep);}
  .composer button:disabled{opacity:.4; cursor:default;}
  .composer svg{width:18px;height:18px;}

  .back-row{
    align-self:flex-start;
    margin-top:-2px;
  }
  .back-chip{
    border:none;
    background:none;
    color:var(--ink-soft);
    font-size:.78rem;
    font-family:'Manrope',sans-serif;
    cursor:pointer;
    display:flex;align-items:center;gap:4px;
    padding:4px 2px;
  }
  .back-chip:hover{color:var(--wine);}

  /* ---- header: logo, marca, botão de agendamentos ---- */
  .logo-badge{
    width:44px;height:44px;
    border-radius:50%;
    background:#fff;
    display:flex;align-items:center;justify-content:center;
    flex-shrink:0;
    overflow:hidden;
    box-shadow:0 3px 8px rgba(0,0,0,.2);
  }
  .logo-badge img{
    width:72%;
    height:auto;
    object-fit:contain;
  }
  .head-text{flex:1; min-width:0;}
  .head-text .name{font-weight:700;}
  .head-text .brand{
    font-family:'Manrope',sans-serif;
    font-weight:700;
    font-size:.72rem;
    letter-spacing:.4px;
    text-transform:uppercase;
    color:#F5E1DD;
    display:block;
  }
  .agenda-btn{
    background:rgba(255,255,255,.14);
    border:1px solid rgba(255,255,255,.35);
    color:#fff;
    font-family:'Manrope',sans-serif;
    font-weight:600;
    font-size:.76rem;
    padding:8px 13px;
    border-radius:999px;
    cursor:pointer;
    flex-shrink:0;
    transition:.15s;
    white-space:nowrap;
  }
  .agenda-btn:hover{background:rgba(255,255,255,.24);}

  /* ---- card de perfil da profissional (aparece ao escolher horário) ---- */
  .profissional-card{
    align-self:flex-start;
    display:flex;
    align-items:center;
    gap:12px;
    background:var(--panel);
    border:1px solid var(--blush-line);
    border-radius:16px;
    padding:10px 16px 10px 10px;
    max-width:88%;
    box-shadow:0 6px 18px -10px rgba(43,27,30,.35);
    animation:rise .3s ease both;
  }
  .profissional-card img{
    width:52px;height:52px;
    border-radius:50%;
    object-fit:cover;
    flex-shrink:0;
    border:2px solid var(--blush);
  }
  .profissional-card .prof-nome{
    font-family:'Fraunces',serif;
    font-weight:600;
    font-size:.95rem;
    color:var(--ink);
  }
  .profissional-card .prof-tag{
    font-size:.74rem;
    color:var(--ink-soft);
  }

  /* ---- painel "meus agendamentos" ---- */
  .agenda-overlay{
    position:absolute;
    inset:0;
    background:rgba(43,27,30,.35);
    display:none;
    align-items:flex-end;
    z-index:20;
  }
  .agenda-overlay.open{display:flex;}
  .agenda-panel{
    background:var(--panel);
    width:100%;
    max-height:78%;
    border-radius:22px 22px 0 0;
    padding:20px 20px 24px;
    overflow-y:auto;
    animation:slideUp .25s ease both;
  }
  @keyframes slideUp{from{transform:translateY(24px); opacity:0;} to{transform:translateY(0); opacity:1;}}
  .agenda-panel h3{
    font-family:'Fraunces',serif;
    margin:0 0 12px;
    font-size:1.1rem;
    color:var(--wine-deep);
    display:flex;
    justify-content:space-between;
    align-items:center;
  }
  .agenda-panel h3 button{
    border:none;background:none;color:var(--ink-soft);
    font-size:1.1rem; cursor:pointer; line-height:1;
  }
  .agenda-item{
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:12px 0;
    border-bottom:1px solid var(--blush-line);
    font-size:.88rem;
  }
  .agenda-item:last-child{border-bottom:none;}
  .agenda-item .ag-servico{font-weight:600; color:var(--ink);}
  .agenda-item .ag-data{color:var(--ink-soft); font-size:.8rem;}
  .ag-alterar-btn{
    flex-shrink:0;
    border:1.5px solid var(--wine);
    background:#fff;
    color:var(--wine);
    font-size:.74rem;
    font-weight:700;
    padding:7px 12px;
    border-radius:999px;
    cursor:pointer;
    white-space:nowrap;
  }
  .ag-alterar-btn:hover{ background:var(--blush); }
  .ag-sem-alteracao{
    flex-shrink:0;
    font-size:.7rem;
    color:var(--ink-soft);
    text-align:right;
    max-width:100px;
  }
  .agenda-empty{
    color:var(--ink-soft);
    font-size:.85rem;
    padding:8px 0 4px;
  }
  .agenda-busca{
    display:flex;
    gap:8px;
    margin-top:10px;
  }
  .agenda-busca input{
    flex:1;
    border:1.5px solid var(--blush-line);
    border-radius:999px;
    padding:10px 14px;
    font-size:16px;
    font-family:'Manrope',sans-serif;
    outline:none;
    background:var(--cream);
    color:var(--ink);
  }
  .agenda-busca input:focus{ border-color:var(--wine); }
  .agenda-busca button{
    border:none;
    background:var(--wine);
    color:#fff;
    font-weight:700;
    font-size:.85rem;
    font-family:'Manrope',sans-serif;
    padding:0 18px;
    border-radius:999px;
    cursor:pointer;
    flex-shrink:0;
  }
  .agenda-busca button:hover{ background:var(--wine-deep); }
  .agenda-erro{
    color:var(--wine);
    font-size:.78rem;
    margin-top:8px;
  }

  /* ---- handoff seguro dentro do painel (quando a busca falha) ---- */
  .agenda-handoff{
    display:flex;
    flex-direction:column;
    gap:12px;
    padding:6px 0 4px;
  }
  .agenda-handoff-texto{
    font-size:.88rem;
    color:var(--ink);
    line-height:1.5;
  }
  .agenda-handoff .wa-btn{
    display:flex;
    align-items:center;
    justify-content:center;
    gap:8px;
    background:#25D366;
    color:#fff;
    text-decoration:none;
    padding:11px;
    border-radius:12px;
    font-weight:700;
    font-size:.85rem;
    font-family:'Manrope',sans-serif;
  }
  .agenda-handoff .wa-btn:hover{ filter:brightness(0.95); }

  /* ---- galeria de trabalhos (dentro do chat) ---- */
  .galeria-msg{
    align-self:flex-start;
    max-width:92%;
    display:flex;
    flex-direction:column;
    gap:6px;
  }
  .galeria-legenda{
    font-size:.78rem;
    color:var(--ink-soft);
    padding-left:2px;
  }
  .galeria-scroll{
    display:flex;
    gap:8px;
    overflow-x:auto;
    padding-bottom:4px;
    scroll-snap-type:x proximity;
  }
  .galeria-scroll::-webkit-scrollbar{height:5px;}
  .galeria-scroll::-webkit-scrollbar-thumb{background:var(--blush-line); border-radius:10px;}
  .galeria-scroll img{
    width:112px;
    height:140px;
    object-fit:cover;
    border-radius:14px;
    flex-shrink:0;
    scroll-snap-align:start;
    border:1px solid var(--blush-line);
    box-shadow:0 6px 14px -8px rgba(43,27,30,.4);
  }

  /* ---- cartão de confirmação de agendamento ---- */
  /* ---- cartão-resumo oficial do agendamento (simples, sem foto/animação) ---- */
  .confirm-card{
    align-self:flex-start;
    max-width:88%;
    background:var(--panel);
    border:1.5px solid var(--blush-line);
    border-radius:18px;
    padding:16px 18px;
    box-shadow:0 10px 26px -14px rgba(43,27,30,.35);
    animation:rise .3s ease both;
    display:flex;
    flex-direction:column;
    gap:9px;
  }
  .confirm-card.confirmado{
    border-color:#3F9463;
  }
  .confirm-card .status-badge{
    align-self:flex-start;
    display:flex;
    align-items:center;
    gap:5px;
    background:var(--gold);
    color:#fff;
    font-size:.7rem;
    font-weight:700;
    letter-spacing:.3px;
    text-transform:uppercase;
    padding:5px 11px;
    border-radius:999px;
    margin-bottom:2px;
  }
  .confirm-card .status-badge.ok{ background:#3F9463; }
  .confirm-card .servico-nome{
    font-family:'Fraunces',serif;
    font-weight:700;
    font-size:1.05rem;
    color:var(--ink);
    line-height:1.3;
  }
  .confirm-card .linha{
    font-size:.85rem;
    color:var(--ink);
    line-height:1.5;
    display:flex;
    align-items:flex-start;
    gap:7px;
  }
  .confirm-card .linha .check{
    color:#3F9463;
    font-weight:700;
    flex-shrink:0;
  }
  .confirm-card .linha .rotulo{ color:var(--ink-soft); }
  .confirm-card .wa-btn{
    display:flex;
    align-items:center;
    justify-content:center;
    gap:8px;
    margin-top:6px;
    background:#25D366;
    color:#fff;
    text-decoration:none;
    padding:11px;
    border-radius:12px;
    font-weight:700;
    font-size:.85rem;
    font-family:'Manrope',sans-serif;
    transition:.15s;
  }
  .confirm-card .wa-btn:hover{ filter:brightness(0.95); }

  /* ---- botão de avaliação no Google ---- */
  .avaliacao-card{
    align-self:flex-start;
  }
  .avaliacao-btn{
    display:inline-flex;
    align-items:center;
    gap:7px;
    background:#fff;
    border:1.5px solid var(--gold);
    color:var(--wine-deep);
    padding:10px 16px;
    border-radius:999px;
    font-weight:700;
    font-size:.85rem;
    font-family:'Manrope',sans-serif;
    text-decoration:none;
    transition:.15s;
  }
  .avaliacao-btn:hover{ background:var(--blush); }

  /* ---- balão de áudio (estilo WhatsApp) ---- */
  .audio-msg{
    align-self:flex-start;
    display:flex;
    align-items:center;
    gap:10px;
    background:var(--blush);
    padding:10px 14px;
    border-radius:16px;
    border-bottom-left-radius:4px;
    max-width:78%;
  }
  .audio-play{
    width:34px;height:34px;
    border-radius:50%;
    background:var(--wine);
    border:none;
    color:#fff;
    display:flex;align-items:center;justify-content:center;
    flex-shrink:0;
    cursor:pointer;
  }
  .audio-play svg{ width:15px; height:15px; }
  .audio-wave{
    flex:1;
    display:flex;
    align-items:center;
    gap:2px;
    height:22px;
  }
  .audio-wave span{
    width:3px;
    background:var(--wine);
    opacity:.45;
    border-radius:2px;
    transition:opacity .15s;
  }
  .audio-wave.playing span{ opacity:.85; }
  .audio-time{
    font-size:.72rem;
    color:var(--ink-soft);
    flex-shrink:0;
    min-width:28px;
  }

  @media (prefers-reduced-motion: reduce){
    .msg, .typing span, .profissional-card, .agenda-panel{animation:none;}
  }
</style>
</head>
<body>

<div class="app">
  <header class="top">
    <div class="logo-badge"><img id="logoImg" src="data:image/jpeg;base64," alt="Carolina Beauty"></div>
    <div class="head-text">
      <span class="name" id="hdrNome">Iza</span>
      <span class="brand" id="hdrBrand">Carolina Beauty</span>
    </div>
    <button class="agenda-btn" id="agendaBtn" type="button">Agendamentos</button>
  </header>

  <main class="thread" id="thread"></main>

  <div class="agenda-overlay" id="agendaOverlay">
    <div class="agenda-panel">
      <h3>Seus agendamentos <button id="fecharAgenda" type="button" aria-label="Fechar">✕</button></h3>
      <div id="agendaLista"></div>
    </div>
  </div>

  <div class="composer" id="composer" style="display:none;">
    <input type="text" id="freeInput" placeholder="Digite aqui..." autocomplete="off">
    <button type="button" id="sendBtn" aria-label="Enviar">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
    </button>
  </div>
</div>


<script>
/* =========================================================================
   CAROLINA BEAUTY — ATENDIMENTO "IZA"
   Padrão: HTML single-file (chat), Google Apps Script (backend),
   Google Calendar (disponibilidade real) + Google Sheets (aba "SQL").
   Mesmo padrão usado na Harmoniziê (Dra. Daniele Caju).

   O ritmo da conversa é propositalmente humano: pausa antes de "ver" a
   mensagem, tempo de digitação proporcional ao tamanho do texto, e
   respostas longas quebradas em mais de uma bolha (como uma pessoa
   digitando de verdade manda, e não um bloco único formatado).

   >>> PREENCHER ANTES DE PUBLICAR <<<
   1) SUPABASE_URL / SUPABASE_KEY (anon) e o slug do negócio (?c=carolina-beauty)
   2) Seção DADOS_FALTANTES abaixo (preços/duração que vieram em branco
      no briefing) e as FAQs.
   ========================================================================= */

const SUPABASE_URL = "https://bbhbqnzaxbyvllunmhwf.supabase.co";
const SUPABASE_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJiaGJxbnpheGJ5dmxsdW5taHdmIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTIxNzIxMzYsImV4cCI6MjEwNzc0ODEzNn0.jJOjhhBDm1yerCgDHkAtJY7Rtpr62O1am8eW41o_uvU"; // anon: pública por design

// Qual negócio carregar: ?c=slug (ou último trecho do caminho). Padrão: carolina-beauty
const SLUG = (()=>{
  const q = new URLSearchParams(location.search).get('c');
  if(q) return q.toLowerCase();
  const seg = location.pathname.split('/').filter(Boolean).pop() || '';
  if(seg && !/\.html?$/i.test(seg) && /^[a-z0-9-]{3,60}$/i.test(seg)) return seg.toLowerCase();
  return 'carolina-beauty';
})();

async function rpc(nome, args){
  const res = await fetch(`${SUPABASE_URL}/rest/v1/rpc/${nome}`, {
    method: "POST",
    headers: { "apikey": SUPABASE_KEY, "Authorization": "Bearer " + SUPABASE_KEY, "Content-Type": "application/json" },
    body: JSON.stringify(args)
  });
  if(!res.ok) throw new Error("rpc " + nome + " HTTP " + res.status);
  return res.json();
}

// >>> ÁUDIOS <<<
// Cole aqui os áudios em base64 quando o Patrick mandar (formato:
// "data:audio/mpeg;base64,XXXX" pra mp3, ou "data:audio/ogg;base64,XXXX"
// pra ogg/m4a). Enquanto estiver null, o balão de áudio não aparece.
const AUDIO_ANTES_AGENDA = null; // removido a pedido do Patrick — não usar mais
const AUDIO_ANTES_AGENDA_DURACAO = "0:05";

let AUDIO_FINAL = "data:audio/mpeg;base64,"; // "Muito obrigada pelo seu agendamento, qualquer informação é só me chamar no WhatsApp."
let AUDIO_FINAL_DURACAO = "0:18";

