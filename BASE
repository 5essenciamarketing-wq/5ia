let reagendamento = null; // { id, servicoNome, duracaoMin }

function iniciarAlteracaoData(item){
  reagendamento = {
    id: item.id,
    servicoNome: item.servico,
    duracaoMin: item.duracao,
    nome: item.nome,
    dataAtual: item.data,
    horaAtual: item.hora
  };
  agendaOverlay.classList.remove('open');
  reagendarEscolherMes();
}

async function reagendarEscolherMes(){
  clearChoices();
  const dias = gerarDiasUteisAte(STUDIO.diasFrente||60);
  const meses = agruparPorMes(dias);

  if(meses.length === 0){
    await bot(`Não achei dias disponíveis pra reagendar 😕 Me chama no ${STUDIO.whatsappApoio}.`);
    renderChoices([{label:"Chamar no WhatsApp", value:"wpp"}], ()=>{
      window.open(`https://wa.me/55${STUDIO.whatsappApoio.replace(/\D/g,'')}`, '_blank');
    });
    return;
  }

  await bot(
    `Beleza, <b>${primeiroNome(reagendamento.nome)}</b>! Vamos alterar o agendamento de ` +
    `<b>${reagendamento.servicoNome}</b> que estava em ${formatDataLegivel(reagendamento.dataAtual)} às ${reagendamento.horaAtual}. Qual mês fica bom pra nova data?`
  );
  renderChoices(
    meses.map(m => ({ label: capitalizar(m.label), value: `${m.label}-${m.ano}` })),
    async (valor) => {
      pushHistory(reagendarEscolherMes);
      const mes = meses.find(m => `${m.label}-${m.ano}` === valor);
      await reagendarEscolherDia(mes);
    },
    { ghostBack: goBack }
  );
}

async function reagendarEscolherDia(mes){
  await bot(`Quais dias de <b>${mes.label}</b> fica bom, <b>${primeiroNome(reagendamento.nome)}</b>?`);
  const opcoes = mes.dias.map(d => ({
    label: d.toLocaleDateString('pt-BR', {weekday:'short', day:'2-digit'}),
    value: dataISOLocal(d)
  }));
  renderChoices(opcoes, async (dataISO) => {
    pushHistory(() => reagendarEscolherDia(mes));
    await reagendarEscolherHorario(dataISO, mes);
  }, { ghostBack: goBack });
}

async function reagendarEscolherHorario(dataISO, mes){
  await bot("Peraí, deixa eu ver aqui na agenda... 💅");
  let slots;
  try{
    slots = await buscarHorariosDisponiveis(dataISO, reagendamento.duracaoMin);
  }catch(e){
    console.warn("Falha ao consultar agenda:", e);
    await bot("Ih, não consegui ver a agenda agora 😕 Tenta de novo.");
    renderChoices([{label:"Tentar de novo", value:"retry"}], () => reagendarEscolherHorario(dataISO, mes));
    return;
  }

  if(slots.length === 0){
    await bot("Esse dia já não tá com horário livre 😕 Escolhe outro dia?");
    renderChoices([{label:"Escolher outro dia", value:"back"}], () => reagendarEscolherDia(mes));
    return;
  }

  await bot("Esses horários estão livres:");
  renderChoices(
    slots.map(h => ({ label: h, value: h })),
    async (hora) => {
      pushHistory(() => reagendarEscolherHorario(dataISO, mes));
      await confirmarAlteracaoData(dataISO, hora);
    },
    { ghostBack: () => reagendarEscolherDia(mes) }
