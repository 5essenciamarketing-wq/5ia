async function boot(){
  try{
    const cfg = await rpc('get_public_config', { p_slug: SLUG });
    if(!cfg || !cfg.config) throw new Error("negócio não encontrado: " + SLUG);
    aplicarConfig(cfg);
  }catch(e){
    console.error("Falha ao carregar configuração:", e);
    document.getElementById('thread').innerHTML =
      '<div style="padding:32px 20px;text-align:center;color:#8F5F5A;font-family:sans-serif">Não consegui abrir o atendimento agora 😕<br>Tenta de novo em instantes.</div>';
    return;
  }
  start();
}
boot();
</script>
