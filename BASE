// Consulta Supabase: horários ocupados do dia
async function buscarHorariosDisponiveis(dataISO, duracaoMin){
  const lista = await rpc('get_ocupados', { p_slug: SLUG, p_data: dataISO });
  if(!Array.isArray(lista)) throw new Error("resposta inválida");
  const ocupados = lista.map(o=>({
    inicio: toMinutes(o.hora),
    fim: toMinutes(o.hora) + Number(o.duracao)
  }));

  const diaSemana = new Date(dataISO + "T00:00:00").getDay(); // 0=Dom ... 6=Sáb
  const horariosDoDia = HORARIOS[String(diaSemana)] || [];

  const livres = [];
  for(const hhmm of horariosDoDia){
    const t = toMinutes(hhmm);
    const fimSlot = t + duracaoMin;
    const conflita = ocupados.some(o => t < o.fim && fimSlot > o.inicio);
    if(!conflita) livres.push(hhmm);
  }
  return livres;
}

function toMinutes(hhmm){
  const [h,m] = hhmm.split(':').map(Number);
  return h*60+m;
}
function toHHMM(min){
  const h = String(Math.floor(min/60)).padStart(2,'0');
  const m = String(min%60).padStart(2,'0');
  return `${h}:${m}`;
}

