function formatDuracao(min){
  const h = Math.floor(min/60), m = min%60;
  if(h && m) return `${h}h${m}min`;
  if(h) return `${h}h`;
  return `${m}min`;
}

function proximosDiasUteis(qtd=6){
  const out = [];
  let d = new Date();
  while(out.length < qtd){
    d.setDate(d.getDate()+1);
    if(STUDIO.diasAtendimento.includes(d.getDay())){
      out.push(new Date(d));
    }
  }
  return out;
}

// Guarda o horário já checado da última data selecionada, pra não bater
// duas vezes na agenda pra mesma data (ex.: se ela clicar "voltar").
let cacheDisponibilidade = {};

// Lembra o mês selecionado, pra "escolher outro dia" voltar pro mesmo mês
// em vez de reiniciar do zero.
let mesSelecionadoAtual = null;

// Gera os próximos dias úteis (respeitando dias de atendimento) dentro
// de uma janela de N dias à frente — padrão 60 dias, porque tem cliente
// que já marca de um mês pro outro.
// Formata a data em "YYYY-MM-DD" usando o horário LOCAL do aparelho —
// nunca use toISOString() pra isso, porque ele converte pra UTC e pode
// virar o dia seguinte à noite (é assim que agendamentos apareciam
// caindo em domingo quando a cliente mexia no site tarde da noite de
// sábado: o Brasil está 3h atrás do UTC).
function dataISOLocal(d){
  const ano = d.getFullYear();
  const mes = String(d.getMonth() + 1).padStart(2, '0');
  const dia = String(d.getDate()).padStart(2, '0');
  return `${ano}-${mes}-${dia}`;
}

// Períodos com a agenda fechada por decisão da Carolina (ex.: fechar
// dezembro provisoriamente). Formato "YYYY-MM-DD" (local).
let PERIODOS_BLOQUEADOS = [
  { inicio: "2026-12-01", fim: "2026-12-31", motivo: "Dezembro fechado (provisório)" }
];

function dataBloqueada(dataISO){
  return PERIODOS_BLOQUEADOS.some(p => dataISO >= p.inicio && dataISO <= p.fim);
}

function gerarDiasUteisAte(diasFrente){
  const out = [];
  for(let i=1; i<=diasFrente; i++){
    const d = new Date();
    d.setDate(d.getDate() + i);
    if(STUDIO.diasAtendimento.includes(d.getDay()) && !dataBloqueada(dataISOLocal(d))){
      out.push(d);
    }
  }
  return out;
}

// Agrupa os dias por mês, na ordem em que aparecem (ex.: Agosto, Setembro, Outubro)
function agruparPorMes(dias){
  const meses = [];
  const porChave = {};
  dias.forEach(d=>{
    const chave = `${d.getFullYear()}-${d.getMonth()}`;
    if(!porChave[chave]){
      const novo = { label: d.toLocaleDateString('pt-BR', {month:'long'}), ano: d.getFullYear(), dias: [] };
      porChave[chave] = novo;
      meses.push(novo);
    }
    porChave[chave].dias.push(d);
  });
  return meses;
}

// Passo 1: escolher o MÊS (olhando os próximos 60 dias de atendimento)
async function stepEscolherMes(){
  clearChoices();
  const dias = gerarDiasUteisAte(STUDIO.diasFrente||60);
  const meses = agruparPorMes(dias);

  if(meses.length === 0){
    await bot(`Não achei nenhum dia disponível nos próximos meses 😕 Me chama direto no ${STUDIO.whatsappApoio} que a gente encaixa você.`);
    renderChoices([{label:"Chamar no WhatsApp", value:"wpp"}], ()=>{
      window.open(`https://wa.me/55${STUDIO.whatsappApoio.replace(/\D/g,'')}`, '_blank');
    });
    return;
  }

  await bot(`Pra qual mês fica bom, <b>${primeiroNome(state.nome)}</b>?`);
  renderChoices(
    meses.map(m => ({ label: capitalizar(m.label), value: `${m.label}-${m.ano}` })),
    async (valor) => {
      pushHistory(stepEscolherMes);
      const mes = meses.find(m => `${m.label}-${m.ano}` === valor);
      await stepEscolherDia(mes);
    },
    { ghostBack: goBack }
  );
}

// Passo 2: escolher o DIA dentro do mês escolhido
async function stepEscolherDia(mes){
  mesSelecionadoAtual = mes;
  await bot(`Quais dias de <b>${mes.label}</b> fica bom?`);
  const opcoes = mes.dias.map(d => ({
    label: d.toLocaleDateString('pt-BR', {weekday:'short', day:'2-digit'}),
    value: dataISOLocal(d)
  }));
  renderChoices(opcoes, async (dataISO) => {
    pushHistory(() => stepEscolherDia(mes));
    state.data = dataISO;
    await stepBuscarDisponibilidade();
  }, { ghostBack: goBack });
}

async function stepBuscarDisponibilidade(){
  await bot(`Peraí, <b>${primeiroNome(state.nome)}</b>, deixa eu ver aqui na agenda... 💅`);
  const agg = servicoAgregado();
  let slots = cacheDisponibilidade[state.data];
  if(!slots){
    try{
      slots = await buscarHorariosDisponiveis(state.data, agg.duracao);
      cacheDisponibilidade[state.data] = slots;
    }catch(e){
      console.warn("Falha ao consultar agenda:", e);
      await bot("Ih, não consegui ver a agenda agora 😕 Tenta de novo ou me chama direto no " + STUDIO.whatsappApoio);
      renderChoices([{label:"Tentar de novo", value:"retry"}], stepBuscarDisponibilidade);
      return;
    }
  }

  const voltarParaDia = () => mesSelecionadoAtual ? stepEscolherDia(mesSelecionadoAtual) : stepEscolherMes();

  if(slots.length === 0){
    await bot("Esse dia já não tá com horário livre pra esse serviço 😕 Quer ver outro dia?");
    renderChoices([{label:"Escolher outro dia", value:"back"}], voltarParaDia);
    return;
  }

  await bot("Esses horários estão livres:");
  renderChoices(
    slots.map(h=>({label:h, value:h})),
    async (hora)=>{
      pushHistory(voltarParaDia);
      state.hora = hora;
      await stepConfirmaHorario();
    },
    { ghostBack: voltarParaDia }
  );
}

