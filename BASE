// Tempo de "digitação" proporcional ao tamanho do texto, com variação
// aleatória — evita o ritmo robótico de delay fixo.
function tempoDigitando(text){
  const len = (text || "").replace(/<[^>]+>/g, "").length;
  const base = 500;
  const porCaractere = 16;
  const variacao = Math.random() * 500;
  return Math.min(2600, Math.max(650, base + len * porCaractere + variacao));
}

// pausa curta simulando "viu a mensagem antes de começar a responder"
function pausaAntesDeVer(){
  return 300 + Math.random() * 450;
}

async function bot(text, {comPausaDeVer=true, delay=null} = {}){
  if(comPausaDeVer){
    await new Promise(r=>setTimeout(r, pausaAntesDeVer()));
  }
  showTyping();
  await new Promise(r=>setTimeout(r, delay ?? tempoDigitando(text)));
  hideTyping();
  addMsg(text, "bot");
}

// Envia várias mensagens em sequência, como uma pessoa mandando
// vários balõezinhos em vez de um bloco único. Só a primeira tem a
// pausa de "viu a mensagem" — as seguintes são a mesma pessoa
// continuando a digitar.
async function botSeq(linhas){
  for(let i=0; i<linhas.length; i++){
    await bot(linhas[i], { comPausaDeVer: i===0 });
  }
}

function clearChoices(){
  document.querySelectorAll('.choices, .back-row').forEach(el=>el.remove());
}

function renderChoices(options, onPick, {ghostBack=null}={}){
  clearChoices();
  const wrap = document.createElement('div');
  wrap.className = 'choices';
  options.forEach(opt=>{
    const b = document.createElement('button');
    b.className = 'chip';
    b.type = 'button';
    b.textContent = opt.label;
    b.onclick = () => {
      addMsg(opt.label, "user");
      wrap.remove();
      backRow?.remove();
      onPick(opt.value);
    };
    wrap.appendChild(b);
  });
  thread.appendChild(wrap);

  let backRow = null;
  if(ghostBack){
    backRow = document.createElement('div');
    backRow.className = 'back-row';
    const bb = document.createElement('button');
    bb.className = 'back-chip';
    bb.type = 'button';
    bb.innerHTML = '← voltar';
    bb.onclick = ghostBack;
    backRow.appendChild(bb);
    thread.appendChild(backRow);
  }
  scrollBottom();
}

function goBack(){
  const prev = state.history.pop();
  if(prev) prev();
}

function pushHistory(fn){ state.history.push(fn); }

