function scrollBottom(){ thread.scrollTop = thread.scrollHeight; }

function addMsg(text, who="bot"){
  const div = document.createElement('div');
  div.className = `msg ${who}`;

  if(who === "user"){
    // simula o "✓✓" de enviado/visto do WhatsApp: cinza ao mandar,
    // vira azul um instante depois (como se a Iza tivesse acabado de ver)
    div.innerHTML = `<span class="msg-texto">${text}</span><span class="ticks" aria-hidden="true">${TICKS_SVG}</span>`;
    thread.appendChild(div);
    scrollBottom();
    const ticksEl = div.querySelector('.ticks');
    setTimeout(()=> ticksEl.classList.add('lido'), 450 + Math.random() * 500);
  } else {
    div.innerHTML = text;
    thread.appendChild(div);
    scrollBottom();
  }
}

