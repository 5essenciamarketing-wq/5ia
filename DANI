      var wasOpen = item.classList.contains('open');
      items.forEach(function(other){ other.classList.remove('open'); });
      if(!wasOpen){ item.classList.add('open'); }
    });
  });
})();

(function(){
  var compare = document.getElementById('compare');
  var beforeImg = document.getElementById('beforeImg');
  var afterImg = document.getElementById('afterImg');
  var galDots = document.getElementById('galDots');
  var galPrev = document.getElementById('galPrev');
  var galNext = document.getElementById('galNext');
  var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  var CASES = [
    { before: 'data:image/jpeg;base64,', after: 'data:image/jpeg;base64,' },
    { before: 'data:image/jpeg;base64,', after: 'data:image/jpeg;base64,' },
    { before: 'data:image/jpeg;base64,', after: 'data:image/jpeg;base64,' }
    { before: 'data:image/jpeg;base64,', after: 'data:image/jpeg;base64,' },
    { before: 'data:image/jpeg;base64,', after: 'data:image/jpeg;base64,' },
    { before: 'data:image/jpeg;base64,', after: 'data:image/jpeg;base64,' },
    { before: 'data:image/jpeg;base64,', after: 'data:image/jpeg;base64,' },
    { before: 'data:image/jpeg;base64,', after: 'data:image/jpeg;base64,' },
    { before: 'data:image/jpeg;base64,', after: 'data:image/jpeg;base64,' },
  ];

  var currentCase = 0;
  var dragging = false;
  var autoplayTimer = null;
  var introRAF = null;
  var switching = false;

  function setPos(pct){
    pct = Math.max(0, Math.min(100, pct));
    compare.style.setProperty('--pos', pct + '%');
    compare.setAttribute('aria-valuenow', Math.round(pct));
  }

  function posFromClientX(clientX){
    var rect = compare.getBoundingClientRect();
    var x = clientX - rect.left;
    return (x / rect.width) * 100;
  }

  function loadCase(index){
    var c = CASES[index];
    beforeImg.src = c.before;
    afterImg.src = c.after;
    setPos(50);
  }

  function renderDots(){
    galDots.innerHTML = '';
    CASES.forEach(function(_, i){
      var dot = document.createElement('button');
      dot.type = 'button';
      dot.className = 'gallery-dot' + (i === currentCase ? ' active' : '');
      dot.setAttribute('aria-label', 'Ver caso ' + (i + 1));
      dot.addEventListener('click', function(){ goToCase(i); });
      galDots.appendChild(dot);
    });
  }

  function goToCase(index){
    if(switching || index === currentCase) return;
    switching = true;
    cancelIntro();
    compare.classList.add('fade-out');
    setTimeout(function(){
      currentCase = (index + CASES.length) % CASES.length;
      loadCase(currentCase);
      renderDots();
      compare.classList.remove('fade-out');
      switching = false;
    }, 260);
  }

  compare.addEventListener('pointerdown', function(e){
    cancelIntro();
    dragging = true;
    compare.setPointerCapture(e.pointerId);
    setPos(posFromClientX(e.clientX));
    pauseAutoplay();
  });
  compare.addEventListener('pointermove', function(e){
    if(!dragging) return;
    setPos(posFromClientX(e.clientX));
  });
  compare.addEventListener('pointerup', function(){
    dragging = false;
    restartAutoplay();
  });
  compare.addEventListener('pointercancel', function(){
    dragging = false;
    restartAutoplay();
  });

  compare.addEventListener('keydown', function(e){
    var current = parseFloat(compare.style.getPropertyValue('--pos')) || 50;
    if(e.key === 'ArrowLeft'){ cancelIntro(); setPos(current - 5); e.preventDefault(); }
    if(e.key === 'ArrowRight'){ cancelIntro(); setPos(current + 5); e.preventDefault(); }
  });

  galPrev.addEventListener('click', function(){ goToCase(currentCase - 1); restartAutoplay(); });
  galNext.addEventListener('click', function(){ goToCase(currentCase + 1); restartAutoplay(); });

  function pauseAutoplay(){
    if(autoplayTimer){ clearInterval(autoplayTimer); autoplayTimer = null; }
  }

  function restartAutoplay(){
    pauseAutoplay();
    autoplayTimer = setInterval(function(){
      if(!dragging && !switching) goToCase(currentCase + 1);
    }, 4000);
  }

  function cancelIntro(){
    if(introRAF){ cancelAnimationFrame(introRAF); introRAF = null; }
  }

  function playIntro(){
    if(reduced) return;
    var keyframes = [50, 22, 78, 42, 50];
    var segMs = 700;
    var totalSegs = keyframes.length - 1;
    var startTime = null;

    function easeInOutQuad(t){
      return t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;
    }

    function tick(ts){
      if(startTime === null) startTime = ts;
      var elapsed = ts - startTime;
      var segIndex = Math.min(Math.floor(elapsed / segMs), totalSegs - 1);
      var segElapsed = elapsed - segIndex * segMs;
      var t = Math.min(segElapsed / segMs, 1);
      var from = keyframes[segIndex];
      var to = keyframes[segIndex + 1];
      setPos(from + (to - from) * easeInOutQuad(t));
      if(elapsed < segMs * totalSegs){
        introRAF = requestAnimationFrame(tick);
      } else {
        setPos(50);
        introRAF = null;
      }
    }

    introRAF = requestAnimationFrame(tick);
  }

  loadCase(0);
  renderDots();

  setTimeout(function(){ playIntro(); }, 500);
  restartAutoplay();
})();

(function(){
  var form = document.getElementById('leadForm');
  var steps = form.querySelectorAll('.step');
  var dots = document.querySelectorAll('.wizard-dot');
  var chipGrid = document.getElementById('chipGrid');
  var chips = chipGrid.querySelectorAll('.chip');
  var selectedChip = null;
  var current = 1;

  function showStep(n){
    steps.forEach(function(s){ s.classList.toggle('active', parseInt(s.dataset.step,10) === n); });
    dots.forEach(function(d){
      var i = parseInt(d.dataset.dot,10);
      d.classList.toggle('done', i < n);
      d.classList.toggle('active', i <= n);
    });
    current = n;
  }

  chips.forEach(function(chip){
    chip.addEventListener('click', function(){
      chips.forEach(function(c){ c.classList.remove('selected'); });
      chip.classList.add('selected');
      selectedChip = chip.dataset.value;
      document.getElementById('err1').classList.remove('show');
    });
  });

  form.querySelectorAll('[data-next]').forEach(function(btn){
    btn.addEventListener('click', function(){
      var step = parseInt(btn.dataset.next,10);
      if(step === 1){
        if(!selectedChip){ document.getElementById('err1').classList.add('show'); return; }
        showStep(2);
      } else if(step === 2){
        var nome = document.getElementById('nome');
        var whats = document.getElementById('whats');
        var okNome = nome.value.trim().length > 1;
        var okWhats = whats.value.replace(/\D/g,'').length >= 10;
        document.getElementById('errNome').classList.toggle('show', !okNome);
        document.getElementById('errWhats').classList.toggle('show', !okWhats);
        if(!okNome || !okWhats) return;
        document.getElementById('sumNome').textContent = nome.value.trim();
        document.getElementById('sumWhats').textContent = whats.value.trim();
        document.getElementById('sumChip').textContent = selectedChip;
        showStep(3);
      }
    });
  });

  form.querySelectorAll('[data-back]').forEach(function(btn){
    btn.addEventListener('click', function(){
      showStep(parseInt(btn.dataset.back,10) - 1);
    });
  });

  form.addEventListener('submit', function(e){
    e.preventDefault();
    var submitBtn = document.getElementById('submitBtn');
    submitBtn.disabled = true;
    submitBtn.textContent = 'Enviando…';

    var nome = document.getElementById('nome').value.trim();
    var whats = document.getElementById('whats').value.trim();

    var mensagem = 'Olá! Vim pela landing page de Lentes em Resina.%0A' +
      'Nome: ' + encodeURIComponent(nome) + '%0A' +
      'Prioridade: ' + encodeURIComponent(selectedChip) + '%0A' +
      'Quero agendar minha avaliação gratuita.';
    var waUrl = 'https://wa.me/' + CONFIG.WHATSAPP_NUMBER + '?text=' + mensagem;

    try{
      fetch(CONFIG.WEBHOOK_URL, {
        method: 'POST',
        mode: 'no-cors',
        headers: { 'Content-Type': 'text/plain;charset=utf-8' },
        body: JSON.stringify({
          nome: nome,
          whatsapp: whats,
          prioridade: selectedChip,
          origem: 'LP Lentes em Resina',
          data: new Date().toISOString()
        })
      });
    }catch(err){}

    document.getElementById('successWaLink').setAttribute('href', waUrl);
    form.style.display = 'none';
    document.getElementById('successPanel').classList.add('active');
    window.open(waUrl, '_blank');
  });
})();
</script>

